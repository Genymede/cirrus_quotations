# Backend mode switch (Phase 4). Leave VITE_API_MODE unset, or set it to
# "legacy", to keep using quotations/backend exactly as today -- no auth,
# same URLs. Set it to "ems" to use ems-backend instead (requires logging
# in on this app's own login screen).
# VITE_API_MODE=legacy

# legacy mode base URL -- each call appends its own path to this
# (/quotations, /items, /units). Must NOT include a trailing slash.
VITE_API_URL=http://localhost:4500/api/inventory

# ems mode only -- the ems-backend host (its own /api/v1/ems prefix and
# route paths are added automatically). Defaults to http://localhost:3000
# when unset.
# VITE_EMS_API_URL=http://localhost:3000

# Phase 8 -- single sign-on handoff (ems mode only). ems-frontend's own dev
# origin: its Quotations nav entry opens this app with the access token in
# the URL fragment (#sso=<token>); the "Back to Cirrus" link and logout both
# navigate back here. Defaults to http://localhost:5174 when unset.
# VITE_EMS_FRONTEND_URL=http://localhost:5174

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
